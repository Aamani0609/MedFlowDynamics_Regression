{
  "name": "playwrite",
  "version": "1.0.0",
  "description": "Playwright tests for Medflow Dynamics",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "regression": "playwright test --grep @regression",
    "regression:headed": "playwright test --grep @regression --headed",
    "regression:governance": "playwright test --grep @governance",
    "regression:evidence-locker": "playwright test --grep @evidence-locker",
