    "test:meetings": "playwright test tests/regression/06-MeetingOrganizer.spec.js",
    "test:meetings:headed": "playwright test tests/regression/06-MeetingOrganizer.spec.js --headed",
    "test:inspection": "playwright test tests/regression/07-CreateInspection.spec.js",
    "test:inspection:headed": "playwright test tests/regression/07-CreateInspection.spec.js --headed",
    "test:risk": "playwright test tests/regression/08-RiskAdd.spec.js tests/regression/09-SafetyEvent.spec.js",
    "test:risk:headed": "playwright test tests/regression/08-RiskAdd.spec.js tests/regression/09-SafetyEvent.spec.js --headed",
    "test:daily": "playwright test tests/regression/10-FridgeMonitoring.spec.js tests/regression/11-DrugConsumable.spec.js tests/regression/12-PremisesChecklist.spec.js tests/regression/13-EquipmentInspection.spec.js",
    "test:daily:headed": "playwright test tests/regression/10-FridgeMonitoring.spec.js tests/regression/11-DrugConsumable.spec.js tests/regression/12-PremisesChecklist.spec.js tests/regression/13-EquipmentInspection.spec.js --headed",
    "test:visitor": "playwright test tests/regression/14-VisitorCheckIn.spec.js",
    "test:visitor:headed": "playwright test tests/regression/14-VisitorCheckIn.spec.js --headed",
    "test:patientvoice": "playwright test tests/regression/15-PatientVoiceDashboard.spec.js tests/regression/16-PatientVoiceInbox.spec.js tests/regression/17-YouSaidWeDid.spec.js tests/regression/18-PatientVoiceQR.spec.js",
    "test:patientvoice:headed": "playwright test tests/regression/15-PatientVoiceDashboard.spec.js tests/regression/16-PatientVoiceInbox.spec.js tests/regression/17-YouSaidWeDid.spec.js tests/regression/18-PatientVoiceQR.spec.js --headed",
    "test:staff": "playwright test tests/regression/19-StaffManagement.spec.js",
    "test:staff:headed": "playwright test tests/regression/19-StaffManagement.spec.js --headed",
    "test:workforce": "playwright test tests/regression/20-WorkforceDashboard.spec.js tests/regression/21-ScheduleRota.spec.js",
    "test:workforce:headed": "playwright test tests/regression/20-WorkforceDashboard.spec.js tests/regression/21-ScheduleRota.spec.js --headed",
    "test:parallel": "playwright test --workers=4 --fully-parallel",
    "test:parallel:headed": "playwright test --workers=4 --fully-parallel --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "node scripts/report.js",
    "report:summary": "node scripts/openSummary.js",
    "install:browsers": "playwright install firefox"
