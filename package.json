    "regression:daily-operations": "playwright test --grep @daily-operations",
    "regression:front-desk": "playwright test --grep @front-desk",
    "regression:staff": "playwright test --grep @staff",
    "regression:workforce": "playwright test --grep @workforce",
    "test:login": "playwright test --project=login",
    "test:login:headed": "playwright test --project=login --headed",
    "test:title": "playwright test tests/regression/02-PageTitles.spec.js",
    "test:title:headed": "playwright test tests/regression/02-PageTitles.spec.js --headed",
    "test:governance": "playwright test tests/regression/03-GovernanceHub.spec.js",
